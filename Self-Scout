<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Yale 2013 AA — Self-Scout</title>
<style>
:root {
  --navy:#1F3A6E; --gold:#BDAB57; --ltblue:#DCE6F1;
  --offwht:#F7F9FC; --grey:#6B7280; --border:#D1D5DB;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:inherit;margin:0;padding:0;}
body{font-family:Arial,sans-serif;background:var(--offwht);color:#111;min-height:100vh;}

.page-header{background:var(--navy);padding:16px 20px;display:flex;align-items:center;gap:14px;}
.page-header h1{color:#fff;font-size:17px;font-weight:bold;letter-spacing:.04em;}
.page-header p{color:var(--gold);font-size:12px;margin-top:2px;}

.tab-bar{background:var(--navy);display:flex;border-bottom:3px solid var(--gold);
  position:sticky;top:env(safe-area-inset-top,0px);z-index:100;}
.tab-btn{flex:1;padding:12px 4px;background:none;border:none;
  color:rgba(255,255,255,.5);font-family:Arial,sans-serif;font-size:12px;
  font-weight:bold;letter-spacing:.05em;text-transform:uppercase;cursor:pointer;
  border-bottom:3px solid transparent;margin-bottom:-3px;}
.tab-btn.active{color:var(--gold);border-bottom:3px solid var(--gold);}

.form-wrap{max-width:640px;margin:0 auto;padding:18px 14px 60px;}

.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;}
.field label{display:block;font-size:10px;font-weight:bold;color:var(--navy);
  text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;}
.field input,.field select,.field textarea{width:100%;border:none;
  border-bottom:2px solid var(--navy);background:transparent;
  font-family:Arial,sans-serif;font-size:14px;padding:4px 2px;outline:none;color:#111;}
.field textarea{border:1px solid var(--border);border-left:4px solid var(--gold);
  background:#fff;border-radius:2px;padding:8px 10px;resize:vertical;
  min-height:64px;font-size:13px;}

.instruction{background:var(--ltblue);border-left:5px solid var(--gold);
  border-radius:2px;padding:10px 12px;font-size:12px;color:#333;
  margin-bottom:16px;line-height:1.5;}
.instruction strong{color:var(--navy);}

.section-hdr{background:var(--navy);color:#fff;font-size:12px;font-weight:bold;
  letter-spacing:.08em;text-transform:uppercase;padding:8px 12px;
  margin-top:16px;border-radius:2px 2px 0 0;}
.section-hdr.gold{background:var(--gold);color:var(--navy);}

.rating-table{width:100%;border-collapse:collapse;}
.rating-table td{border:1px solid var(--border);padding:7px 8px;
  font-size:12px;vertical-align:middle;}
.rating-table tr:nth-child(odd) td{background:#fff;}
.rating-table tr:nth-child(even) td{background:var(--offwht);}
.scale-row td{background:var(--ltblue)!important;font-size:10px;
  color:#555;font-style:italic;}
.scale-row .nc{width:32px;text-align:center;font-weight:bold;
  color:var(--navy);font-style:normal;font-size:12px;}
.r-cell{width:32px;padding:4px 2px!important;text-align:center;}
.radio-group{display:flex;justify-content:center;}
.radio-group input[type=radio]{display:none;}
.radio-group label{display:flex;align-items:center;justify-content:center;
  width:26px;height:26px;border-radius:50%;cursor:pointer;font-size:11px;
  font-weight:bold;color:var(--navy);}
.radio-group input[type=radio]:checked+label{background:var(--navy);color:#fff;}

.goal-block{background:#fff;border:1px solid var(--border);
  border-left:4px solid var(--navy);border-radius:0 2px 2px 0;
  padding:12px;margin-bottom:8px;}
.goal-block h4{font-size:12px;color:var(--navy);font-weight:bold;margin-bottom:8px;}
.yn-row{display:flex;align-items:center;gap:6px;margin-bottom:5px;font-size:12px;flex-wrap:wrap;}
.yn-row span{min-width:155px;color:#333;}
.yn-row label{display:flex;align-items:center;gap:3px;cursor:pointer;
  font-size:11px;color:var(--navy);font-weight:bold;}
.yn-row input[type=radio]{accent-color:var(--navy);width:13px;height:13px;}

.refl-label{font-size:12px;font-weight:bold;color:var(--navy);margin:14px 0 5px;}
.helios-box{background:#fff;border:1px solid var(--border);padding:12px;margin-bottom:2px;}

.submit-btn{display:block;width:100%;margin-top:24px;padding:13px;
  background:var(--navy);color:#fff;border:none;border-radius:4px;
  font-family:Arial,sans-serif;font-size:14px;font-weight:bold;
  letter-spacing:.05em;cursor:pointer;text-transform:uppercase;}
.submit-btn:disabled{background:#9CA3AF;cursor:default;}
.submit-btn:active{background:#162d58;}

/* Confirm screen */
.confirm-screen{display:none;max-width:640px;margin:40px auto;padding:0 14px;}
.confirm-card{background:#fff;border:1px solid var(--border);
  border-top:4px solid var(--gold);border-radius:4px;padding:24px 20px;text-align:center;}
.confirm-card h2{color:var(--navy);font-size:18px;margin-bottom:10px;}
.confirm-card p{color:#444;font-size:13px;line-height:1.6;margin-bottom:16px;}
.confirm-card .email-note{background:var(--ltblue);border-radius:4px;
  padding:10px 14px;font-size:12px;color:var(--navy);font-weight:bold;margin-bottom:20px;}
.send-btn{display:inline-block;padding:13px 28px;background:var(--gold);
  color:var(--navy);border:none;border-radius:4px;font-family:Arial,sans-serif;
  font-size:14px;font-weight:bold;cursor:pointer;text-decoration:none;
  letter-spacing:.04em;}
.reset-btn{display:block;margin:14px auto 0;background:none;border:none;
  color:var(--grey);font-family:Arial,sans-serif;font-size:12px;
  cursor:pointer;text-decoration:underline;}

.toast{display:none;position:fixed;bottom:calc(env(safe-area-inset-bottom,0px)+20px);
  left:50%;transform:translateX(-50%);background:#065F46;color:#fff;
  padding:10px 22px;border-radius:8px;font-size:13px;font-weight:bold;
  z-index:999;text-align:center;max-width:88vw;}
.toast.show{display:block;}
.hidden{display:none!important;}
</style>
</head>
<body>

<div class="page-header">
  <div>
    <h1>YALE 2013 AA</h1>
    <p id="form-subtitle">Self-Scout</p>
  </div>
</div>

<div class="tab-bar">
  <button class="tab-btn active" onclick="switchTab('player')">Player</button>
  <button class="tab-btn" onclick="switchTab('goalie')">Goaltender</button>
</div>

<!-- ═══ PLAYER FORM ═══ -->
<div id="tab-player">
<div class="form-wrap" id="p-form">
  <div class="info-grid">
    <div class="field"><label>Your Name</label><input type="text" id="p-player" placeholder="First Last"></div>
    <div class="field"><label>Date</label><input type="date" id="p-date"></div>
    <div class="field"><label>Opponent / Session</label><input type="text" id="p-opponent" placeholder="e.g. East Haven"></div>
    <div class="field"><label>Shifts / Period Reviewed</label><input type="text" id="p-shifts" placeholder="e.g. P1, shifts 3-5"></div>
  </div>

  <div class="instruction">
    <strong>Instructions:</strong> Fill in your HELIOS numbers first. Then watch one or two of your shifts.
    <strong><em>Do not watch the puck. Watch yourself.</em></strong>
    Note shift timestamps above if your platform shows them.
  </div>

  <div class="section-hdr">HELIOS Check</div>
  <div class="helios-box">
    <div class="info-grid" style="margin-bottom:10px;">
      <div class="field"><label>Session Type</label>
        <select id="p-session-type"><option value="">Select...</option>
          <option>Practice</option><option>Game</option><option>Skills</option></select></div>
      <div class="field"><label>Hustle Score</label><input type="number" id="p-hustle" min="1" max="99" placeholder="e.g. 63"></div>
      <div class="field"><label>Load</label><input type="text" id="p-load" placeholder="e.g. 74"></div>
      <div class="field"><label>Stride Time</label><input type="text" id="p-stride" placeholder="e.g. 13:05"></div>
      <div class="field" style="grid-column:1/-1"><label>Energy Ratio</label><input type="text" id="p-energy" placeholder="e.g. 56%"></div>
    </div>
    <div class="field" style="margin-bottom:8px;"><label>What does the data suggest?</label><textarea id="p-data-suggest" rows="2"></textarea></div>
    <div style="font-size:12px;margin-bottom:5px;font-weight:bold;color:var(--navy);">Does the video support the data?</div>
    <div class="yn-row" style="margin-bottom:8px;">
      <label><input type="radio" name="p-vs" value="Yes"> Yes</label>
      <label><input type="radio" name="p-vs" value="No"> No</label>
      <label><input type="radio" name="p-vs" value="Not Sure"> Not Sure</label>
    </div>
    <div class="field"><label>Why?</label><textarea id="p-video-why" rows="2"></textarea></div>
  </div>

  <div class="section-hdr" style="margin-top:16px;">General Habits</div>
  <table class="rating-table" id="p-general">
    <tr class="scale-row"><td>1=Rarely | 2=Occasionally | 3=Sometimes | 4=Usually | 5=Consistently</td>
    <td class="nc r-cell">1</td><td class="nc r-cell">2</td><td class="nc r-cell">3</td><td class="nc r-cell">4</td><td class="nc r-cell">5</td></tr>
  </table>

  <div class="section-hdr">With the Puck</div>
  <table class="rating-table" id="p-puck"></table>

  <div class="section-hdr gold">Forwards Only</div>
  <table class="rating-table" id="p-fwd"></table>

  <div class="section-hdr gold">Defensemen Only</div>
  <table class="rating-table" id="p-def"></table>

  <div class="section-hdr" style="margin-top:20px;">Reflection</div>
  <div style="background:#fff;border:1px solid var(--border);padding:12px;">
    <div class="refl-label">One thing I did well</div>
    <div class="field"><textarea id="p-r1" rows="3"></textarea></div>
    <div class="refl-label">One habit I want to improve</div>
    <div class="field"><textarea id="p-r2" rows="3"></textarea></div>
    <div class="refl-label">One thing I will focus on in my next practice or game</div>
    <div class="field"><textarea id="p-r3" rows="3"></textarea></div>
  </div>
  <button class="submit-btn" onclick="submitPlayer()" id="p-btn">Review & Submit</button>
</div>

<div class="confirm-screen" id="p-confirm">
  <div class="confirm-card">
    <h2>Ready to send!</h2>
    <p>Your self-scout will open in your email app, pre-filled and ready to go. Just hit <strong>Send</strong>.</p>
    <div class="email-note">Sending to: Coach Gallini</div>
    <a id="p-mailto-link" href="#" class="send-btn">Open Email App &rarr;</a>
    <button class="reset-btn" onclick="resetPlayer()">Go back and edit</button>
  </div>
</div>
</div>

<!-- ═══ GOALIE FORM ═══ -->
<div id="tab-goalie" class="hidden">
<div class="form-wrap" id="g-form">
  <div class="info-grid">
    <div class="field"><label>Your Name</label><input type="text" id="g-player" placeholder="First Last"></div>
    <div class="field"><label>Date</label><input type="date" id="g-date"></div>
    <div class="field"><label>Opponent</label><input type="text" id="g-opponent" placeholder="e.g. East Haven"></div>
    <div class="field"><label>Period(s) Reviewed</label><input type="text" id="g-periods" placeholder="e.g. P1, P2"></div>
  </div>

  <div class="instruction">
    <strong>Instructions:</strong> Watch one or two shifts or a full period.
    <strong><em>Do not watch the puck. Watch yourself.</em></strong>
    Fill in goals against as you watch. Reflection last.
  </div>

  <div class="section-hdr">General Habits</div>
  <table class="rating-table" id="g-general">
    <tr class="scale-row"><td>1=Rarely | 2=Occasionally | 3=Sometimes | 4=Usually | 5=Consistently</td>
    <td class="nc r-cell">1</td><td class="nc r-cell">2</td><td class="nc r-cell">3</td><td class="nc r-cell">4</td><td class="nc r-cell">5</td></tr>
  </table>

  <div class="section-hdr">Positioning</div>
  <table class="rating-table" id="g-pos"></table>

  <div class="section-hdr">Puck Management</div>
  <table class="rating-table" id="g-puck"></table>

  <div class="section-hdr" style="margin-top:20px;">Every Goal Against</div>
  <div style="background:var(--ltblue);padding:6px 12px;font-size:11px;color:#555;font-style:italic;margin-bottom:8px;">
    Four blocks provided — leave unused blocks blank
  </div>
  <div id="goal-blocks"></div>

  <div class="section-hdr" style="margin-top:20px;">Reflection</div>
  <div style="background:#fff;border:1px solid var(--border);padding:12px;">
    <div class="refl-label">One thing I did well</div>
    <div class="field"><textarea id="g-r1" rows="3"></textarea></div>
    <div class="refl-label">One habit I want to improve</div>
    <div class="field"><textarea id="g-r2" rows="3"></textarea></div>
    <div class="refl-label">One thing I will focus on in my next practice or game</div>
    <div class="field"><textarea id="g-r3" rows="3"></textarea></div>
  </div>
  <button class="submit-btn" onclick="submitGoalie()" id="g-btn">Review & Submit</button>
</div>

<div class="confirm-screen" id="g-confirm">
  <div class="confirm-card">
    <h2>Ready to send!</h2>
    <p>Your self-scout will open in your email app, pre-filled and ready to go. Just hit <strong>Send</strong>.</p>
    <div class="email-note">Sending to: Coach Gallini</div>
    <a id="g-mailto-link" href="#" class="send-btn">Open Email App &rarr;</a>
    <button class="reset-btn" onclick="resetGoalie()">Go back and edit</button>
  </div>
</div>
</div>

<div class="toast" id="toast"></div>

<script>
const COACH_EMAIL = "brian.gallini@quinnipiac.edu";

const PQ = {
  general:[
    "Did I move quickly after possession changed?",
    "Was I first to support the play?",
    "Did I stop hard on pucks in transition?",
    "Did I win puck races?",
    "Was I moving my feet rather than gliding?",
    "Was my stick on the ice and available?",
    "Did I communicate with teammates?",
    "Did I recover through the middle of the ice?",
    'Did I arrive with a "stick on puck" mindset when initiating contact?',
  ],
  puck:[
    "Did I make tape-to-tape flat passes?",
    "Did I receive passes cleanly?",
    "Did I make the next play easier for a teammate?",
    "Did I move the puck quickly and efficiently?",
    "Did I support the puck after making a pass?",
  ],
  fwd:[
    "Was I engaged on the forecheck?",
    "Did I run the L correctly? (pressure → peel → support)",
    "Did I have an attitude of recovery in transition?",
    "Did I get to the net — or support — when the puck went to the point?",
  ],
  def:[
    "Did I protect the middle of the ice?",
    "Did I establish my gap early?",
    "Did I prevent opponents from getting behind me?",
    "As D1, was I first to puck retrievals?",
    "Were my OZ point shots low and on net?",
  ],
};

const GQ = {
  general:[
    "Was I ready and set before the shot?",
    "Did I reset quickly after each play?",
    "Did I stay square to the puck?",
    "Was I communicating with my defensemen?",
    "Did I stay mentally engaged when the puck was away from me?",
    "Did I recover emotionally after goals and mistakes?",
  ],
  pos:[
    "Was I on angle?",
    "Did I have proper depth?",
    "Did I arrive set before the shot?",
    "Did I track rebounds effectively?",
    "Did I recover quickly after saves?",
  ],
  puck:[
    "Did I make good puck decisions?",
    "Did I leave pucks safely for defensemen?",
    "Did I communicate retrievals clearly?",
  ],
};

function buildTable(id, qs, pfx) {
  const t = document.getElementById(id);
  if (!t) return;
  qs.forEach((q, i) => {
    const tr = document.createElement("tr");
    let h = `<td>${q}</td>`;
    for (let n=1;n<=5;n++) h+=`<td class="r-cell"><div class="radio-group">
      <input type="radio" name="${pfx}-${id}-${i}" id="${pfx}${id}${i}${n}" value="${n}">
      <label for="${pfx}${id}${i}${n}">${n}</label></div></td>`;
    tr.innerHTML = h; t.appendChild(tr);
  });
}

function buildGoals() {
  const c = document.getElementById("goal-blocks");
  for (let g=1;g<=4;g++) {
    const d = document.createElement("div");
    d.className = "goal-block";
    const yns = ["Could I see the puck?","Was I set before the shot?","Was my positioning correct?"];
    d.innerHTML = `<h4>Goal #${g}</h4>`
      + yns.map((q,qi)=>`<div class="yn-row"><span>${q}</span>
          <label><input type="radio" name="gg${g}q${qi}" value="Yes"> Yes</label>
          <label><input type="radio" name="gg${g}q${qi}" value="No"> No</label></div>`).join("")
      + `<div class="yn-row"><span>Reasonably saveable?</span>
          <label><input type="radio" name="gg${g}q3" value="Yes"> Yes</label>
          <label><input type="radio" name="gg${g}q3" value="Maybe"> Maybe</label>
          <label><input type="radio" name="gg${g}q3" value="No"> No</label></div>
        <div class="field" style="margin-top:8px;">
          <label>What would I do differently next time?</label>
          <textarea id="ggoal${g}notes" rows="2"></textarea></div>`;
    c.appendChild(d);
  }
}

function switchTab(tab) {
  ["player","goalie"].forEach((t,i) => {
    document.getElementById("tab-"+t).classList.toggle("hidden", t!==tab);
    document.querySelectorAll(".tab-btn")[i].classList.toggle("active", t===tab);
  });
  document.getElementById("form-subtitle").textContent =
    tab==="player" ? "Player Self-Scout" : "Goaltender Self-Scout";
}

function toast(msg,dur=3000){
  const t=document.getElementById("toast");
  t.textContent=msg; t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"),dur);
}

function getRating(id, qs, pfx) {
  const lines = [];
  qs.forEach((q,i) => {
    const s = document.querySelector(`input[name="${pfx}-${id}-${i}"]:checked`);
    lines.push(`  ${q}: ${s ? s.value+"/5" : "—"}`);
  });
  return lines.join("\n");
}

function getGoalBlocks() {
  const yq = ["Could I see the puck?","Was I set before the shot?","Was my positioning correct?","Reasonably saveable?"];
  const lines = [];
  for (let g=1;g<=4;g++) {
    const answers = yq.map((q,qi) => {
      const s = document.querySelector(`input[name="gg${g}q${qi}"]:checked`);
      return s ? `${q} ${s.value}` : null;
    }).filter(Boolean);
    const notes = document.getElementById(`ggoal${g}notes`)?.value || "";
    if (answers.length || notes) {
      lines.push(`  Goal #${g}: ${answers.join(" | ")}`);
      if (notes) lines.push(`  Next time: ${notes}`);
    }
  }
  return lines.length ? lines.join("\n") : "  None recorded";
}

function buildMailto(subject, body) {
  return `mailto:${COACH_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

// ── Player submit ─────────────────────────────────────────────────────────────
function submitPlayer() {
  const player = document.getElementById("p-player").value.trim();
  if (!player) { toast("Please enter your name"); return; }

  const date    = document.getElementById("p-date").value || "—";
  const opp     = document.getElementById("p-opponent").value || "—";
  const shifts  = document.getElementById("p-shifts").value || "—";
  const stype   = document.getElementById("p-session-type").value || "—";
  const hustle  = document.getElementById("p-hustle").value || "—";
  const load    = document.getElementById("p-load").value || "—";
  const stride  = document.getElementById("p-stride").value || "—";
  const energy  = document.getElementById("p-energy").value || "—";
  const dataSug = document.getElementById("p-data-suggest").value || "—";
  const vs      = document.querySelector("input[name=\'p-vs\']:checked")?.value || "—";
  const vsWhy   = document.getElementById("p-video-why").value || "—";
  const r1      = document.getElementById("p-r1").value || "—";
  const r2      = document.getElementById("p-r2").value || "—";
  const r3      = document.getElementById("p-r3").value || "—";

  const subject = `[Self-Scout] ${player} — ${opp} — ${date}`;
  const body = [
    "YALE 2013 AA — PLAYER SELF-SCOUT",
    "═══════════════════════════════",
    `Player:   ${player}`,
    `Date:     ${date}`,
    `Opponent: ${opp}`,
    `Shifts:   ${shifts}`,
    `Session:  ${stype}`,
    "",
    "── HELIOS ──────────────────────",
    `Hustle Score:  ${hustle}`,
    `Load:          ${load}`,
    `Stride Time:   ${stride}`,
    `Energy Ratio:  ${energy}`,
    `Data suggests: ${dataSug}`,
    `Video supports data? ${vs}`,
    `Why: ${vsWhy}`,
    "",
    "── GENERAL HABITS ──────────────",
    getRating("p-general", PQ.general, "p"),
    "",
    "── WITH THE PUCK ───────────────",
    getRating("p-puck", PQ.puck, "p"),
    "",
    "── FORWARDS ONLY ───────────────",
    getRating("p-fwd", PQ.fwd, "p"),
    "",
    "── DEFENSEMEN ONLY ─────────────",
    getRating("p-def", PQ.def, "p"),
    "",
    "── REFLECTION ──────────────────",
    `One thing I did well:`,
    `  ${r1}`,
    "",
    `One habit I want to improve:`,
    `  ${r2}`,
    "",
    `Focus for next session:`,
    `  ${r3}`,
  ].join("\n");

  document.getElementById("p-mailto-link").href = buildMailto(subject, body);
  document.getElementById("p-form").classList.add("hidden");
  document.getElementById("p-confirm").style.display = "block";
}

function resetPlayer() {
  document.getElementById("p-confirm").style.display = "none";
  document.getElementById("p-form").classList.remove("hidden");
}

// ── Goalie submit ─────────────────────────────────────────────────────────────
function submitGoalie() {
  const player = document.getElementById("g-player").value.trim();
  if (!player) { toast("Please enter your name"); return; }

  const date    = document.getElementById("g-date").value || "—";
  const opp     = document.getElementById("g-opponent").value || "—";
  const periods = document.getElementById("g-periods").value || "—";
  const r1      = document.getElementById("g-r1").value || "—";
  const r2      = document.getElementById("g-r2").value || "—";
  const r3      = document.getElementById("g-r3").value || "—";

  const subject = `[Self-Scout] ${player} (G) — ${opp} — ${date}`;
  const body = [
    "YALE 2013 AA — GOALTENDER SELF-SCOUT",
    "═════════════════════════════════════",
    `Player:  ${player}`,
    `Date:    ${date}`,
    `Opponent: ${opp}`,
    `Periods: ${periods}`,
    "",
    "── GENERAL HABITS ──────────────",
    getRating("g-general", GQ.general, "g"),
    "",
    "── POSITIONING ─────────────────",
    getRating("g-pos", GQ.pos, "g"),
    "",
    "── PUCK MANAGEMENT ─────────────",
    getRating("g-puck", GQ.puck, "g"),
    "",
    "── GOALS AGAINST ───────────────",
    getGoalBlocks(),
    "",
    "── REFLECTION ──────────────────",
    `One thing I did well:`,
    `  ${r1}`,
    "",
    `One habit I want to improve:`,
    `  ${r2}`,
    "",
    `Focus for next session:`,
    `  ${r3}`,
  ].join("\n");

  document.getElementById("g-mailto-link").href = buildMailto(subject, body);
  document.getElementById("g-form").classList.add("hidden");
  document.getElementById("g-confirm").style.display = "block";
}

function resetGoalie() {
  document.getElementById("g-confirm").style.display = "none";
  document.getElementById("g-form").classList.remove("hidden");
}

// ── Init ──────────────────────────────────────────────────────────────────────
(()=>{
  buildTable("p-general", PQ.general, "p");
  buildTable("p-puck",    PQ.puck,    "p");
  buildTable("p-fwd",     PQ.fwd,     "p");
  buildTable("p-def",     PQ.def,     "p");
  buildTable("g-general", GQ.general, "g");
  buildTable("g-pos",     GQ.pos,     "g");
  buildTable("g-puck",    GQ.puck,    "g");
  buildGoals();
  const today = new Date().toISOString().split("T")[0];
  document.getElementById("p-date").value = today;
  document.getElementById("g-date").value = today;
})();
</script>
